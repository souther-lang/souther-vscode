{
  "name": "souther",
  "displayName": "Souther",
  "description": "Souther language support: the language server, syntax highlighting, and a Java runtime it fetches for you.",
  "version": "0.1.1",
  "publisher": "souther",
  "license": "EPL-2.0",
  "southerVersion": "0.1.0-rc5",
  "repository": {
    "type": "git",
    "url": "https://github.com/souther-lang/souther-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/souther-lang/souther-vscode/issues"
  },
  "homepage": "https://github.com/souther-lang/souther-vscode#readme",
  "keywords": [
    "souther",
    "language server",
    "lsp",
    "sou"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icon.png",
  "main": "./src/extension.js",
  "scripts": {
    "fetch": "node scripts/fetch-artifacts.mjs",
    "test": "node --test",
    "package": "vsce package",
    "vscode:prepublish": "node -e \"['server/souther-lsp.jar','syntaxes/souther.tmLanguage.json'].forEach(f => require('fs').accessSync(f))\""
  },
  "activationEvents": [
    "onLanguage:souther",
    "workspaceContains:**/*.sou"
  ],
  "contributes": {
    "languages": [
      {
        "id": "souther",
        "aliases": [
          "Souther"
        ],
        "extensions": [
          ".sou"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "souther",
        "scopeName": "source.souther",
        "path": "./syntaxes/souther.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "souther.restartServer",
        "title": "Restart Language Server",
        "category": "Souther"
      },
      {
        "command": "souther.showOutput",
        "title": "Show Output",
        "category": "Souther"
      }
    ],
    "configuration": {
      "title": "Souther",
      "properties": {
        "souther.server.jar": {
          "type": "string",
          "default": "",
          "description": "Path to souther-lsp.jar. Defaults to server/souther-lsp.jar inside the extension."
        },
        "souther.server.java": {
          "type": "string",
          "default": "",
          "description": "The java executable used to launch the language server. Leave empty to use a Java 25 from JAVA_HOME or the PATH, or one the extension downloads."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.10.1"
  }
}
